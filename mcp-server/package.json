{
  "name": "historical-weather-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing the same historical-weather lookup (Open-Meteo geocoding + archive, median/average aggregation, metric/imperial units) as the Historical Weather Flutter app.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "historical-weather-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
